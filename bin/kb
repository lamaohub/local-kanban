#!/usr/bin/env node
// kb — the token-efficient CLI for the kanban board (localhost:3100).
// Tasks are addressed by key (TIC-3) or by global id. One line of output per action.

import { parsePm2Services } from '../src/pm2-services.js';

const BASE = process.env.KB_URL || 'http://127.0.0.1:3100';
const PRI = { 0: '', 1: 'p1', 2: 'p2', 3: 'p3' };
const PRI_BY_NAME = { none: 0, low: 1, med: 2, medium: 2, high: 3, p0: 0, p1: 1, p2: 2, p3: 3 };
const ST_ALIAS = {
  b: 'backlog', backlog: 'backlog', t: 'todo', todo: 'todo',
  pp: 'prep', prep: 'prep', d: 'doing', doing: 'doing',
  dp: 'deploy', deploy: 'deploy', r: 'review', review: 'review', dn: 'done', done: 'done',
  c: 'cancelled', cancelled: 'cancelled', cancel: 'cancelled',
};

// Exit codes are a contract for automation (scripts gate their moves on them):
// 0 — success, 1 — the board is not responding, 2 — the request was rejected (4xx or an
// unknown command), 3 — kb itself broke, 4 — the board answered, but with a failure of its
// own (5xx) or with something that is not JSON. Previously an exception exited with 1 as well,
// so "the board is down" was indistinguishable from "kb is broken".
// Code 4 exists because 2 was answering two different questions at once. A live board that
// answers with an honest 500 (a broken row in the database) used to exit with the SAME code as
// a lawful refusal of a transition — there was no way to tell "the board falls over on my
// request" from "you are not allowed to do that". Worse, a 200 whose body is not JSON made
// `kb mv` print "undefined undefined" and exit 0: it reported a move that never happened, and
// that is exactly what someone whose KB_URL points at a different port would see (several
// ports are live on this machine).
const EXIT = { DOWN: 1, REJECTED: 2, INTERNAL: 3, BOARD_ERROR: 4 };

function die(msg, code = EXIT.REJECTED) { process.stderr.write(msg + '\n'); process.exit(code); }

async function api(method, path, body) {
  let res;
  try {
    res = await fetch(BASE + path, {
      method,
      headers: body ? { 'Content-Type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
  } catch {
    die('kb: board is not responding — pm2 restart kanban', EXIT.DOWN);
  }
  if (res.status === 204) return null;
  const text = await res.text();
  let data = null;
  let parsed = false;
  try { data = JSON.parse(text); parsed = true; } catch { /* not JSON — see below */ }
  if (!res.ok) {
    const detail = parsed ? (data?.error || res.status) : `${res.status} ${text.slice(0, 200)}`;
    // 5xx is the board failing on us, not us asking for something forbidden — its own code.
    die(`kb: ${detail}`, res.status >= 500 ? EXIT.BOARD_ERROR : EXIT.REJECTED);
  }
  if (!parsed) {
    die(`kb: the board answered ${res.status} with something that is not JSON — is KB_URL (${BASE}) the board?`, EXIT.BOARD_ERROR);
  }
  return data;
}

function taskLine(t) {
  const flags = [t.blocked ? '!' : '', PRI[t.priority] || ''].filter(Boolean).join(' ');
  const labels = (t.labels || []).length ? ` [${t.labels.join(',')}]` : '';
  return `${t.key} ${t.status}${flags ? ' ' + flags : ''} ${t.title}${labels}`;
}

// The checklist is part of the task's spec: the board shows it right under the description, and
// this CLI is the only channel Claude has — an item that is not printed here does not exist for
// Claude. Markdown task-list lines, `- [ ]` open and `- [x]` done, in the board's order.
function printChecklist(t) {
  for (const c of (t.checklist || [])) console.log(`- [${c.done ? 'x' : ' '}] ${c.text}`);
}

// here, and the skill's rule "related tasks solved together are taken together" cannot be followed
// without knowing they are related. `rel` is relative to this task: 'parent' — the other task is
// this one's parent, 'child' — the other task is a sub-task of this one, 'related' — symmetric.
const REL = { parent: ['↑', 'parent'], child: ['↓', 'subtask'], related: ['↔', 'related'] };
function printLinks(t) {
  for (const l of (t.links || [])) {
    const [arrow, word] = REL[l.rel] || REL.related;
    console.log(`${arrow} ${word} ${l.key} ${l.title} (${l.status})`);
  }
}
const linksLine = (id, links) => `${id} ${links.map((l) => (REL[l.rel] || REL.related)[0] + l.key).join(' ') || '—'}`;

// the skill had to explain two formats. The number goes into commit messages, the link is for eyes.
function printIssue(t) {
  if (t.gh_issue_number) console.log(`issue: #${t.gh_issue_number}${t.gh_issue_url ? ' ' + t.gh_issue_url : ''}`);
  else if (t.gh_issue_url) console.log(`issue: ${t.gh_issue_url}`);
}

// sees cards in the column, and a bare "empty" made Claude report that there was nothing there.
function emptyLine(todo) {
  const blocked = todo.filter((t) => t.blocked).length;
  return blocked ? `empty (${blocked} blocked)` : 'empty';
}

function printAttachments(t) {
  for (const a of (t.attachments || [])) console.log(`📎 screenshot (open it with Read): ${a.path}`);
}

// Comments. Three authors: the human ('me'), Claude, and 'git' — the commit stat the board attaches
// by itself on the move to review. Each gets its own mark: a commit printed as 👤 read as the human
const WHO = { claude: '🤖', git: '⎇' };

// The database keeps UTC ('YYYY-MM-DD HH:MM:SS'); print local time, to the minute — enough to tell
function when(c) {
  const d = new Date(String(c.created_at || '').replace(' ', 'T') + 'Z');
  if (Number.isNaN(d.getTime())) return '';
  const p = (n) => String(n).padStart(2, '0');
  return `[${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}] `;
}

function printComment(c) {
  const at = when(c);
  if (c.body) console.log(`> ${WHO[c.author] || '👤'} ${at}${c.author === 'git' ? 'commit ' : ''}${c.body}`);
  if (c.image_path) console.log(`📎 image from a comment ${at}(open it with Read): ${c.image_path}`);
}

// Claude's last report — not just the latest one (a send-back plus a follow-up note lost the first)
// and not whatever happens to fit a window of the last few (Claude's own notes and commit stats
// pushed the human out of it). Those are always printed; `window` adds the last N comments of any
// author on top, and the latest images stay too — they are usually the correction itself. When the
// human has said nothing since the last report, the last thing they did say is printed, dated, so
// it can be told apart from a fresh one. Whatever is left out is counted, never dropped silently.
function printComments(cs, window) {
  const keep = new Set();
  let lastReport = -1;
  cs.forEach((c, i) => { if (c.author === 'claude') lastReport = i; });
  const human = (c) => c.author !== 'claude' && c.author !== 'git';
  cs.forEach((c, i) => { if (i > lastReport && human(c)) keep.add(i); });
  if (!keep.size) {
    const i = cs.findLastIndex((c) => human(c) && c.body);
    if (i >= 0) keep.add(i);
  }
  for (let i = Math.max(0, cs.length - window); i < cs.length; i++) keep.add(i);
  cs.map((c, i) => (c.image_path ? i : -1)).filter((i) => i >= 0).slice(-3).forEach((i) => keep.add(i));
  const hidden = cs.length - keep.size;
  if (hidden > 0) console.log(`… ${hidden} more comment${hidden === 1 ? '' : 's'} not printed — the board has them all`);
  cs.forEach((c, i) => { if (keep.has(i)) printComment(c); });
}

const [cmd, ...args] = process.argv.slice(2);

async function tick(done) {
  const [id, n] = args;
  const no = Number(n);
  if (!id || !Number.isInteger(no) || no < 1) die(`kb ${done ? 'check' : 'uncheck'} <key> <n>  (n = the item number, from 1, in the order kb show prints them)`);
  const t = await api('GET', `/api/tasks/${id}`);
  const items = t.checklist || [];
  if (no > items.length) die(`kb: ${t.key} has ${items.length ? `only ${items.length} checklist item${items.length === 1 ? '' : 's'}` : 'no checklist'}`);
  const item = await api('PATCH', `/api/tasks/${id}/checklist/${items[no - 1].id}`, { done });
  const open = items.filter((c, i) => (i === no - 1 ? !item.done : !c.done)).length;
  console.log(`${t.key} - [${item.done ? 'x' : ' '}] ${item.text} (${open} open)`);
}

const commands = {
  async p() {
    const ps = await api('GET', '/api/projects');
    if (!ps.length) return console.log('no projects');
    for (const p of ps) {
      console.log(`${p.slug} (${p.prefix}) b${p.c_backlog || 0} t${p.c_todo || 0} pp${p.c_prep || 0} d${p.c_doing || 0} dp${p.c_deploy || 0} r${p.c_review || 0} ✓${p.c_done || 0}${p.c_blocked ? ` !${p.c_blocked}` : ''}`);
    }
  },

  async ls() {
    const [proj] = args.filter((a) => !a.startsWith('-'));
    if (!proj) die('kb ls <project> [-s status] [-a]');
    const si = args.indexOf('-s');
    const q = new URLSearchParams({ project: proj });
    if (si >= 0) q.set('status', ST_ALIAS[args[si + 1]] || args[si + 1]);
    if (args.includes('-a')) q.set('all', '1');
    const ts = await api('GET', `/api/tasks?${q}`);
    if (!ts.length) return console.log('empty');
    for (const t of ts) console.log(taskLine(t));
  },

  async next() {
    const [proj] = args;
    if (!proj) die('kb next <project>');
    const ts = await api('GET', `/api/tasks?${new URLSearchParams({ project: proj, status: 'todo' })}`);
    const free = ts.filter((t) => !t.blocked);
    console.log(free.length ? taskLine(free[0]) : emptyLine(ts));
  },

  // take the next task and put it straight into prep (study before code); prints what the human
  // wrote since Claude's last report (notes from a send-back). Writing code → kb mv <key> doing.
  async take() {
    const [proj] = args;
    if (!proj) die('kb take <project>');
    const ts = await api('GET', `/api/tasks?${new URLSearchParams({ project: proj, status: 'todo' })}`);
    const free = ts.filter((t) => !t.blocked);
    if (!free.length) return console.log(emptyLine(ts));
    const t = await api('PATCH', `/api/tasks/${free[0].id}`, { status: 'prep' });
    console.log(taskLine({ ...t, labels: t.labels }));
    if (t.description) console.log(t.description);
    // PATCH answers with the bare row; the checklist and the attachments live on the full card
    const full = await api('GET', `/api/tasks/${t.id}`);
    printChecklist(full);
    printLinks(full);
    printIssue(full);
    printAttachments(full);
    printComments(await api('GET', `/api/tasks/${t.id}/comments`), 0);
  },

  // leave a note and move to review in one command
  async review() {
    const [id, note] = args;
    if (!id || !note) die('kb review <key> "note"');
    await api('POST', `/api/tasks/${id}/comments`, { body: note, author: 'claude' });
    const t = await api('PATCH', `/api/tasks/${id}`, { status: 'review' });
    console.log(`${t.key} review 📝`);
  },

  async show() {
    const [id] = args;
    if (!id) die('kb show <key>');
    const t = await api('GET', `/api/tasks/${id}`);
    console.log(`${t.key} ${t.project} ${t.status}${t.blocked ? ` blocked: ${t.blocked_reason || ''}` : ''}${PRI[t.priority] ? ' ' + PRI[t.priority] : ''}${t.labels.length ? ' [' + t.labels.join(',') + ']' : ''}`);
    console.log(t.title);
    if (t.description) console.log(t.description);
    printChecklist(t);
    printLinks(t);
    printIssue(t);
    printAttachments(t);
    printComments(await api('GET', `/api/tasks/${id}/comments`), 5);
  },

  async add() {
    const flagVals = new Set();
    ['-d', '-p', '-s'].forEach((f) => { const i = args.indexOf(f); if (i >= 0) flagVals.add(i + 1); });
    const pos = args.filter((a, i) => !a.startsWith('-') && !flagVals.has(i));
    const [proj, title] = pos;
    if (!proj || !title) die('kb add <project> "title" [-d "description"] [-p high|med|low] [-s todo]');
    const di = args.indexOf('-d');
    const pi = args.indexOf('-p');
    const si = args.indexOf('-s');
    const body = { project: proj, title };
    if (di >= 0) body.description = args[di + 1] || '';
    if (pi >= 0) {
      const pr = PRI_BY_NAME[args[pi + 1]];
      if (pr === undefined) die('kb: priority high|med|low|none');
      body.priority = pr;
    }
    if (si >= 0) {
      body.status = ST_ALIAS[args[si + 1]];
      if (!body.status) die('kb: status backlog|todo|prep|doing|deploy|review|done');
    }
    const t = await api('POST', '/api/tasks', body);
    console.log(`${t.key} ${t.status} ${t.project}`);
  },

  async mv() {
    const [id, st] = args;
    const status = ST_ALIAS[st];
    if (!id || !status) die('kb mv <key> backlog|todo|prep|doing|deploy|review|done|cancelled');
    const t = await api('PATCH', `/api/tasks/${id}`, { status });
    console.log(`${t.key} ${t.status}`);
  },

  async done() {
    const [id] = args;
    if (!id) die('kb done <key>');
    const t = await api('PATCH', `/api/tasks/${id}`, { status: 'done' });
    console.log(`${t.key} done`);
  },

  async cancel() {
    const [id] = args;
    if (!id) die('kb cancel <key>');
    const t = await api('PATCH', `/api/tasks/${id}`, { status: 'cancelled' });
    console.log(`${t.key} cancelled`);
  },

  async pri() {
    const [id, p] = args;
    const pr = PRI_BY_NAME[p];
    if (!id || pr === undefined) die('kb pri <key> high|med|low|none');
    const t = await api('PATCH', `/api/tasks/${id}`, { priority: pr });
    console.log(`${t.key} ${PRI[t.priority] || 'p0'}`);
  },

  async lbl() {
    const [id, ...ops] = args;
    if (!id || !ops.length) die('kb lbl <key> +bug -ui  (+ to add, - to remove)');
    const t = await api('GET', `/api/tasks/${id}`);
    const labels = new Set(t.labels);
    for (const op of ops) {
      if (op.startsWith('+')) labels.add(op.slice(1));
      else if (op.startsWith('-')) labels.delete(op.slice(1));
    }
    const fresh = await api('PATCH', `/api/tasks/${id}`, { labels: [...labels] });
    console.log(`${fresh.key} [${fresh.labels.join(',')}]`);
  },

  async desc() {
    const [id, text] = args;
    if (!id || text === undefined) die('kb desc <key> "description"  (set or overwrite the description)');
    const t = await api('PATCH', `/api/tasks/${id}`, { description: text });
    console.log(`${t.key} 📝 description updated`);
  },

  async note() {
    const [id, body] = args;
    if (!id || !body) die('kb note <key> "text"');
    await api('POST', `/api/tasks/${id}/comments`, { body, author: 'claude' });
    const t = await api('GET', `/api/tasks/${id}`);
    console.log(`${t.key} 📝`);
  },

  // kb link A B [child|parent|related] — `child`: B becomes a sub-task of A, `parent`: B becomes
  // A's parent. Without a third word the link is plain `related`, as it always was. A pair holds
  // one link, so linking again with another word re-types it. The word is looked up as an OWN key:
  // `REL[rel]` also answers for `constructor`, `toString` or `__proto__` (they come from the
  // prototype), and such a word went to the board, which quietly made the link `related`.
  async link() {
    const [id, other, rel = 'related'] = args;
    if (!id || !other || !Object.hasOwn(REL, rel)) die('kb link <key> <key> [child|parent|related]  (child: the second task becomes a sub-task of the first)');
    const links = await api('POST', `/api/tasks/${id}/links`, { key: other, rel });
    console.log(linksLine(id, links));
  },

  async unlink() {
    const [id, other] = args;
    if (!id || !other) die('kb unlink <key> <key>');
    const links = await api('DELETE', `/api/tasks/${id}/links/${other}`);
    console.log(linksLine(id, links));
  },

  // empty and could not tell what of the list was done. The item is addressed by its number — the
  // position in which show/take print it (the board's order), counting from 1.
  async check() { await tick(true); },
  async uncheck() { await tick(false); },

  async block() {
    const [id, reason] = args;
    if (!id) die('kb block <key> ["reason"]');
    const t = await api('PATCH', `/api/tasks/${id}`, { blocked: true, blocked_reason: reason || '' });
    console.log(`${t.key} blocked${t.blocked_reason ? ': ' + t.blocked_reason : ''}`);
  },

  async unblock() {
    const [id] = args;
    if (!id) die('kb unblock <key>');
    const t = await api('PATCH', `/api/tasks/${id}`, { blocked: false });
    console.log(`${t.key} unblocked`);
  },

  async rm() {
    const [id] = args;
    if (!id) die('kb rm <key>');
    await api('DELETE', `/api/tasks/${id}`);
    console.log(`${id} deleted`);
  },

  async info() {
    const [proj] = args;
    if (!proj) die('kb info <project>');
    const p = await api('GET', `/api/projects/${proj}`);
    const out = [`${p.slug} (${p.prefix}): ${p.name}`];
    if (p.path) out.push(`path: ${p.path}`);
    if (p.deploy_skill) out.push(`deploy_skill: ${p.deploy_skill}${p.deploy_skill_path ? ` (${p.deploy_skill_path})` : ''}`);
    if (p.server) out.push(`server: ${p.server}${p.server_path ? ':' + p.server_path : ''}`);
    const services = parsePm2Services(p.pm2_services);
    if (services.length) out.push(`pm2: ${services.join(', ')}`);
    if (p.domain) out.push(`domain: ${p.domain}`);
    // CLAUDE.md", "deployed by skill X", DNS facts) — info printed everything but it
    if (p.description) out.push(`description: ${p.description}`);
    // page; without this line Claude went looking by itself and sometimes missed. A missing
    // CLAUDE.md is said out loud — it is a signal (the task starts without architecture notes).
    if (p.path) {
      const d = await api('GET', `/api/projects/${encodeURIComponent(p.slug)}/docs`);
      const found = (d.docs || []).filter((x) => x.exists).map((x) => x.name);
      if (!d.path_exists) out.push('docs: — the project folder does not exist on this machine');
      else if (!found.includes('CLAUDE.md')) out.push(`docs: no CLAUDE.md${found.length ? ` — read ${found.join(', ')} instead` : ', and no README.md / ARCHITECTURE.md either'}`);
      else out.push(`docs: ${found.join(', ')}`);
    }
    console.log(out.join('\n'));
  },

  async svc() {
    const [proj] = args;
    if (!proj) die('kb svc <project>');
    const list = await api('GET', `/api/projects/${proj}/status`);
    for (const s of list) {
      if (s.status === 'not found') { console.log(`${s.name}: not found in pm2`); continue; }
      console.log(`${s.name}: ${s.status} | up ${s.uptime_h}h | rst ${s.restarts} | ${s.mem_mb}MB | cpu ${s.cpu}%`);
    }
  },

  async sync() {
    const s = await api('GET', '/api/sync');
    if (s.configured === false) { console.log('sync is off (local-only) — set owner/repo in the board settings or via KB_GH_OWNER/KB_GH_REPO'); return; }
    let line = `queue:${s.pending}`;
    if (s.failed.length) line += ` failed:${s.failed.length} (${s.failed[0].op}: ${(s.failed[0].last_error || '').slice(0, 80)})`;
    if (s.gh === false) line += ' [gh unavailable: gh auth login && gh auth refresh -s project]';
    console.log(line);
  },

  async retry() {
    await api('POST', '/api/sync/retry');
    console.log('ok');
  },
};

if (!cmd || !commands[cmd]) {
  die('kb p|ls|next|take|show|add|mv|review|done|cancel|pri|lbl|desc|note|link|unlink|check|uncheck|block|unblock|rm|info|svc|sync|retry');
}
commands[cmd]().catch((e) => {
  // die() inside a command already exited the process — only real exceptions reach here.
  if (process.env.KB_DEBUG) process.stderr.write((e && e.stack) || String(e));
  die(`kb: internal error — ${(e && e.message) || e} (stack trace: KB_DEBUG=1)`, EXIT.INTERNAL);
});
